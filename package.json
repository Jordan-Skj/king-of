{
  "name": "king-off-6j-iphone-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n CSS,VITE -c blue,cyan \"npm:dev:css\" \"npm:dev:vite\"",
    "dev:css": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "dev:vite": "vite --host 0.0.0.0",
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "build": "npm run build:css && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
